	"naming_rules": [
		{ "rule": "bg-primary는 밝은 핑크 '서피스' 전용. 텍스트에 text-primary 금지 (중립 배경에서 대비 불가). 강조 텍스트는 text-primary-text", "basis": "globals.css:37 주석 + DESIGN.md" },
		{ "rule": "bg-brand / bg-primary-control은 액션 채움·on-state 전용. 그 위 라벨은 text-primary-control-text", "basis": "globals.css:39-46 주석" },
		{ "rule": "*-foreground 토큰은同名 서피스 위 텍스트 전용 (text-muted-foreground = --muted 위 설명 텍스트)", "basis": "shadcn 관례" },
		{ "rule": "border 계열(--border, --border-subtle, --border-strong)은 선/경계 전용. border-border-strong는 텍스트 사용 금지(비텍스트 대비 3:1 목적)", "basis": "globals.css:199 주석 + DESIGN.md" },
		{ "rule": "--surface-1/2/3는 배경(bg-surface-*) 전용. 1=기본 패널, 2=중첩/인셋, 3=플로팅 오버레이", "basis": "globals.css:169-177 + DESIGN.md" },
		{ "rule": "--discord-* 토큰은 Discord UI 프리뷰 재현 컴포넌트(EmbedPreview 등) 전용", "basis": "globals.css:62-67 + discord-patterns skill" },
		{ "rule": "상태색(--success/--warning/--info/--destructive)은 상태 표시 전용. 관례: text-{status} on bg-{status}/10", "basis": "globals.css:240-241 주석" },
		{ "rule": "반경은 역할 토큰 사용: rounded-control(버튼/인풋/셀렉트), rounded-menu(드롭다운/팝오버), rounded-card(카드/패널), rounded-dialog(모달/시트). Tailwind 기본 rounded-xl/2xl은 역할·값이 모두 맞을 때만 허용", "basis": "globals.css:164-167 + DESIGN.md" },
		{ "rule": "모션은 이름형 duration-fast/base/slow만 사용. 숫자형 duration-200/300/500 금지(값이 1:1 동일)", "basis": "DESIGN.md" },
		{ "rule": "--switch-thumb는 Switch 컴포넌트 내부 전용", "basis": "globals.css:47 주석" },
		{ "rule": "간격은 Tailwind 기본 스케일만 사용, 커스텀 간격 토큰 없음(유일 예외 --hero-scroll-hint-gap)", "basis": "DESIGN.md" },
		{ "rule": "섹션 라벨은 SectionLabel(text-xs font-medium text-muted-foreground). font-black/uppercase/tracking-widest 금지", "basis": "DESIGN.md" }
	],
