{
  "name": "sirubot",
  "version": "5.2.12",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "resolutions": {
    "mysql2": "3.24.6"
  },
  "devDependencies": {
    "@swc/core": "1.15.47",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "build": "turbo build",
    "generate": "turbo run generate",
    "migrate:dev": "turbo run migrate:dev",
