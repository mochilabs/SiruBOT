# Database (Prisma)
# 포맷: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://sirubot:sirubot_dev@localhost:5432/sirubot?schema=public"

# NextAuth (Discord OAuth)
# https://discord.com/developers/applications 에서 생성 — Bot용 애플리케이션과 같은 것 공유 가능
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# 세션 암호화용 랜덤 문자열 — `openssl rand -base64 32` 로 생성
AUTH_SECRET=""
# Discord OAuth 토큰 암호화 전용 키 — `openssl rand -base64 32` 로 생성.
# 비우면 AUTH_SECRET에서 유도하지만, AUTH_SECRET을 회전하면 저장된 refresh 토큰이 모두 복호 불가가 돼요.
# 설정하면 저장 시점부터 이 키로 다시 암호화되고(복호는 두 키 모두 시도), 이후 AUTH_SECRET 회전이 안전해요.
TOKEN_ENCRYPTION_KEY=""
# 리버스 프록시(HTTPS) 뒤에서만 true 아니라도 됨 — false면 next-auth가 UntrustedHost로 세션 조회 거부
AUTH_TRUST_HOST="true"

# 초대 링크 생성용 (클라이언트 노출)
NEXT_PUBLIC_DISCORD_CLIENT_ID=""
# 대시보드 URL (클라이언트 노출) — 프로덕션에선 실제 도메인
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 샤드매니저 연동 (봇 프로덕션 상태·플레이어 읽기)
# 봇 개발 모드에선 없어도 동작 — 기본값이 로컬호스트로 잡혀 있어요
SHARD_MANAGER_URL="http://localhost:3001"
SHARD_MANAGER_AUTH_KEY="youshallnotpass"

# 이미지 저장소(apps/storage) 연동 — 길드 이미지 에셋 업로드/삭제
# 스토리지 주소 — 미설정 시 기본값 http://localhost:3003 로 잡혀 있어요
STORAGE_URL="http://localhost:3003"
# 저장소와 공유하는 인증 키 — STORAGE_AUTH_KEY가 비어 있으면 AUTH_KEY로 폴백해요 (둘 중 하나만 있으면 동작)
# ⚠️ 둘 다 없으면 이미지 에셋 업로드·삭제가 전부 실패해요 — data-api 키와 같은 값을 쓰는 게 일반적이에요
# (공유 키는 아래 data-api 항목의 AUTH_KEY 한 곳만 관리해요)
# STORAGE_AUTH_KEY=""

# 대시보드 운영자 allowlist — /api/shards, /api/data-api 등 인프라 텔레메트리 API 노출 제한용
# ⚠️ 미설정이면 전원 차단(fail-closed) — 운영 환경에서는 반드시 설정하세요
# DASHBOARD_ADMIN_IDS="123456789012345678,987654321098765432"

# Redis (rate-limit·길드 캐시·토큰 갱신 뮤텍스) — 미설정 시 메모리 폴백(단일 인스턴스 전제)으로 동작
# REDIS_URL="redis://localhost:6379"

# data-api 연동 (채널/역할 조회, 웹 플레이어, 이미지 렌더 등 봇 연동 기능)
# data-api 주소 — 미설정 시 기본값 http://localhost:3002 로 잡혀 있어요
DATA_API_URL="http://localhost:3002"
# data-api와 공유하는 인증 키 — DATA_API_AUTH_KEY가 비어 있으면 AUTH_KEY로 폴백해요 (둘 중 하나만 있으면 동작)
# ⚠️ 둘 다 없으면 봇 연동 기능(채널/역할 조회, 웹 플레이어, 이미지 렌더)이 전부 실패해요 — 배포 시 빠뜨리지 말 것
# Authorization 헤더에 Bearer 스킴 없이 키 원문을 그대로 실어요 — data-api·봇·대시보드가 같은 키를 공유해야 해요
DATA_API_AUTH_KEY=""
# AUTH_KEY=""

# 선택 — 공식 지원 서버 초대 링크. 있으면 푸터에 노출
# NEXT_PUBLIC_SUPPORT_SERVER="https://discord.gg/..."

# 음성 서버 통계 연동 (시스템 상태 페이지의 음성 서버 카드)
# Lavalink 통계 서버의 조회 API — 미설정 시 https://lavalink.siru.life 로 잡혀 있어요
LAVALINK_STATS_URL="https://lavalink.siru.life"
