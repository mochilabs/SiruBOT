# Database (Prisma)
# 포맷: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://sirubot:sirubot_dev@localhost:5432/sirubot?schema=public"

# NextAuth (Discord OAuth)
# https://discord.com/developers/applications 에서 생성 — Bot용 애플리케이션과 같은 것 공유 가능
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# 세션 암호화용 랜덤 문자열 — `openssl rand -base64 32` 로 생성
AUTH_SECRET=""
# 리버스 프록시(HTTPS) 뒤에서만 true 아니라도 됨 — false면 next-auth가 UntrustedHost로 세션 조회 거부
AUTH_TRUST_HOST="true"

# 초대 링크 생성용 (클라이언트 노출)
NEXT_PUBLIC_DISCORD_CLIENT_ID=""
# 대시보드 URL (클라이언트 노출) — 프로덕션에선 실제 도메인
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 샤드매니저 연동 (봇 프로덕션 상태·플레이어 읽기)
# 봇 개발 모드에선 없어도 동작 — 기본값이 로컬호스트로 잡혀 있어요
SHARD_MANAGER_URL="http://localhost:3001"
SHARD_MANAGER_AUTH_KEY="youshallnotpass"

# data-api 연동 (채널/역할 조회, 웹 플레이어, 이미지 렌더 등 봇 연동 기능)
# data-api 주소 — 미설정 시 기본값 http://localhost:3002 로 잡혀 있어요
DATA_API_URL="http://localhost:3002"
# data-api와 공유하는 인증 키 — DATA_API_AUTH_KEY가 비어 있으면 AUTH_KEY로 폴백해요 (둘 중 하나만 있으면 동작)
# ⚠️ 둘 다 없으면 봇 연동 기능(채널/역할 조회, 웹 플레이어, 이미지 렌더)이 전부 실패해요 — 배포 시 빠뜨리지 말 것
# Authorization 헤더에 Bearer 스킴 없이 키 원문을 그대로 실어요 — data-api·봇·대시보드가 같은 키를 공유해야 해요
DATA_API_AUTH_KEY=""
# AUTH_KEY=""

# 선택 — 공식 지원 서버 초대 링크. 있으면 푸터에 노출
# NEXT_PUBLIC_SUPPORT_SERVER="https://discord.gg/..."
