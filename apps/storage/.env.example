# storage 환경 변수 — 스키마 원본: src/config/env.ts

# 서버 포트 (기본 3003)
PORT=3003

# 저장 루트 디렉토리 — 컨테이너에선 /data 볼륨 마운트로 영속화해요
STORAGE_DATA_DIR=./data

# 공개 GET URL 베이스 — 디스코드가 임베드로 fetch하는 주소예요 (반드시 https 공개 도메인)
# 발급 URL은 스냅샷이라 도메인이 바뀌면 기존 에셋 URL 일괄 치환이 필요해요
STORAGE_PUBLIC_URL=https://cdn.example.com

# 인증 키 — STORAGE_AUTH_KEY ?? AUTH_KEY 폴백으로 읽어요
# ⚠️ 둘 다 없으면 기동 자체를 거부해요 (fail-closed) — 인증 면제는 /health와 공개 오브젝트 GET뿐
# 호출 측(대시보드)은 Authorization 헤더에 Bearer 스킴 없이 키 원문을 그대로 실어야 해요 — data-api와 같은 계약
# STORAGE_AUTH_KEY=
# AUTH_KEY=
