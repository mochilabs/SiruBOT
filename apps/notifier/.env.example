# notifier 환경 변수 — 스키마 원본: src/config/env.ts

# 서버 포트 (기본 3004)
PORT=3004

# Redis — 웹훅 생성 request/reply 허브가 써요 (봇과 공유). 없으면 허브가 경고만 남기고 꺼져요.
# REDIS_URL=redis://localhost:6379

# Prisma 연결 — 구독·이벤트 로그 저장에 써요. 첫 사용 시 lazy 연결해요.
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sirubot"

# 인증 키 — notifier는 NOTIFIER_AUTH_KEY ?? AUTH_KEY 폴백으로 읽어요
# ⚠️ 둘 다 없으면 기동 자체를 거부해요 (fail-closed, config/env.ts) — 인증 면제는 /health와 공개 콜백뿐이에요
# 봇·data-api·storage와 같은 값을 쓰는 게 일반적이에요
# NOTIFIER_AUTH_KEY=
# AUTH_KEY=

# 로그 레벨 (앱 로거 — 숫자 또는 tslog 이름, 기본 info)
# LOGLEVEL=info

# --- 유튜브 WebSub (NOTIFIER_PUBLIC_URL + YOUTUBE_HUB_SECRET 세트가 있어야 푸시가 켜져요) ---
# 콜백이 도달할 공개 주소 (경로 없이) — 예: https://notifier.example.com
# NOTIFIER_PUBLIC_URL=https://notifier.example.com
# WebSub hub.secret — 콜백 X-Hub-Signature HMAC 검증에 써요
# YOUTUBE_HUB_SECRET=

# --- 트위치 EventSub (Client ID/Secret + 공개 URL + 검증 시크릿 세트가 있어야 푸시가 켜져요) ---
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# EventSub 구독 secret — 콜백 HMAC 검증 + 구독 생성에 같이 써요 (트위치 규칙: 20~100자)
# TWITCH_EVENTSUB_SECRET=

# --- 치지직 폴러 킬 스위치 — 'false'일 때만 꺼요 (기본 켜짐) ---
# CHZZK_POLLING_ENABLED=true
