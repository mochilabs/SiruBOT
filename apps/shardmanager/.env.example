# Server listen port (기본 3001 — Dockerfile EXPOSE 3001)
PORT=3001
# Discord bot token
DISCORD_TOKEN=TOKEN
# Shard count, if shard count is "auto" server will request to discord gateway
SHARD_COUNT=auto
# Defer NEW shard allocation after startup (ms) so existing bots can re-claim theirs first. 0 disables
ALLOCATION_GRACE_MS=40000
# Log level
LOGLEVEL=info
# Auth for shard manager
AUTH_KEY=youshallnotpass
# Notifier
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1234567890