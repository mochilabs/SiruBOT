# Server listen port
PORT=3000
# Discord bot token
DISCORD_TOKEN=TOKEN
# Shard count, if shard count is "auto" server will request to discord gateway
SHARD_COUNT=auto
# Log level
LOGLEVEL=info
# Auth for shard manager
AUTH_KEY=youshallnotpass
# BROADCASTEVAL 원격 eval 릴레이 게이트 — 명시 활성화 전까지 모두 거절
# ENABLE_BROADCAST_EVAL=true
# Notifier
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1234567890