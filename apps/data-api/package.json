{
    "name": "@sirubot/data-api",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "lint": "prettier --check \"src/**/*.ts\"",
        "lint:fix": "prettier --write \"src/**/*.ts\"",
        "test": "vitest run --passWithNoTests --config ../../vitest.config.ts",
        "typecheck": "tsc --noEmit",
        "build": "tsup",
        "watch": "tsup --watch",
        "start": "node --enable-source-maps .",
        "backfill:recordings": "node --enable-source-maps dist/scripts/backfillRecordings.js"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.10.1",
        "@redis/client": "^5.12.1",
        "@sirubot/app-kit": "workspace:^",
        "@sirubot/cards": "*",
        "@sirubot/isrc": "*",
        "@sirubot/prisma": "*",
        "@sirubot/utils": "*",
        "@takumi-rs/core": "^2.22.1",
        "@takumi-rs/helpers": "^2.22.1",
        "fastify": "^5.12.7",
        "js-yaml": "^4.3.2",
        "skia-canvas": "^3.0.8",
        "tslog": "^4.11.0",
        "youtubei.js": "18.3.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/js-yaml": "^4.0.9"
    }
}
