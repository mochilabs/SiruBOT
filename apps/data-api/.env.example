# data-api 환경 변수 — 스키마 원본: src/config/env.ts

# 서버 포트 (기본 3002)
PORT=3002

# Redis URL — 캐시·request/reply 허브·세션에 써요. 없으면 메모리 폴백으로 동작해요
REDIS_URL=redis://localhost:6379

# 인증 키 — data-api는 DATA_API_AUTH_KEY ?? AUTH_KEY 폴백으로 읽어요
# ⚠️ 둘 다 없으면 기동 자체를 거부해요 (fail-closed, plugins/auth.ts) — 인증 면제는 /api/health뿐
# 호출 측(대시보드·봇)은 Authorization 헤더에 Bearer 스킴 없이 키 원문을 그대로 실어야 해요 — 같은 키를 공유하세요
# DATA_API_AUTH_KEY=
# AUTH_KEY=

# 로그 레벨 (기본 info)
# LOGLEVEL=info

# 실행 환경 (기본 development)
# NODE_ENV=development

# --- 번역 (OpenAI 호환 엔드포인트, /api/translate) ---
# 프로바이더가 없으면 원문 그대로 served + translated:false 로 응답해요 (기본 openai)
# TRANSLATION_PROVIDER=openai
# OPENAI_COMPATIBLE_API_URL=http://127.0.0.1:8080/v1
# OPENAI_API_KEY=
# 번역 모델 (기본 default — 서버 기본 모델 사용)
# TRANSLATION_MODEL=default

# 오하아사 일일 갱신 시각 (KST, '06:50' 형태)
# OHAASA_REFRESH_AT=06:50

# --- 메모리 정리 (nightly pass) — DATABASE_URL이 있을 때만 활성화돼요 ---
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sirubot"
# MEMORY_TIDY_ENABLED=true
# MEMORY_TIDY_AT=00:00
# MEMORY_TIDY_BATCH_SIZE=40
