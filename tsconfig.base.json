{
	"extends": ["@sapphire/ts-config", "@sapphire/ts-config/extra-strict", "@sapphire/ts-config/decorators"],
	"compilerOptions": {
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"noEmit": true,
		"incremental": false,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"baseUrl": ".",
		"paths": {
			"@sirubot/utils": ["./packages/utils/src/index.ts"],
			"@sirubot/shardclient": ["./packages/shardclient/src/index.ts"],
			"@sirubot/shardclient/ws-types": ["./packages/shardclient/src/ws-types/index.ts"],
			"@sirubot/prisma": ["./packages/prisma/dist/index.d.ts"]
		}
	}
}
