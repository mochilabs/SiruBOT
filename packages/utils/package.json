    "scripts": {
        "lint": "prettier --check \"src/**/*.ts\"",
        "lint:fix": "prettier --write \"src/**/*.ts\"",
        "test": "vitest run --passWithNoTests --config ../../vitest.config.ts",
        "typecheck": "tsc --noEmit",
        "build": "tsup",
        "watch": "tsup --watch"
    },
    "peerDependencies": {
        "lavalink-client": "^2.0.0"
    },
    "devDependencies": {
        "@sapphire/ts-config": "^5.0.1",
        "@types/node": "^22.18.1"
    },
    "dependencies": {
        "@redis/client": "^5.8.2",
        "@sentry/node": "^9.15.0",
        "@sentry/profiling-node": "^9.15.0",
        "discord.js": "^14.0.0",
        "tslog": "^4.10.2",
        "undici": "^7.30.1",
        "zod": "^4.1.11"
