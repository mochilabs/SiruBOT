            "types": "./dist/sentry.d.ts",
            "import": "./dist/sentry.js",
            "require": "./dist/sentry.cjs"
        },
        "./customCommand": {
            "types": "./dist/customCommand.d.ts",
            "import": "./dist/customCommand.js",
            "require": "./dist/customCommand.cjs"
        },
        "./chatTools": {
            "types": "./dist/chatTools.d.ts",
            "import": "./dist/chatTools.js",
            "require": "./dist/chatTools.cjs"
        },
        "./playerState": {
            "types": "./dist/playerState.d.ts",
            "import": "./dist/playerState.js",
            "require": "./dist/playerState.cjs"
        },
        "./guildData": {
            "types": "./dist/guildData.d.ts",
            "import": "./dist/guildData.js",
            "require": "./dist/guildData.cjs"
        },
        "./memberGreeting": {
            "types": "./dist/memberGreeting.d.ts",
