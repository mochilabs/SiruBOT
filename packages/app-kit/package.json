{
    "name": "@sirubot/app-kit",
    "private": true,
    "version": "0.1.0",
    "main": "dist/index.js",
    "type": "module",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "scripts": {
        "lint": "prettier --check \"src/**/*.ts\"",
        "lint:fix": "prettier --write \"src/**/*.ts\"",
        "test": "vitest run --passWithNoTests --config ../../vitest.config.ts",
        "typecheck": "tsc --noEmit",
        "build": "tsup",
        "watch": "tsup --watch"
    },
    "dependencies": {
        "fastify": "^5.12.7",
        "tslog": "^4.10.2",
        "zod": "^4.1.11"
    },
    "devDependencies": {
        "@types/node": "^22.18.1"
    }
}
