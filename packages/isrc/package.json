{
    "name": "@sirubot/isrc",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "main": "dist/index.js",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "scripts": {
        "lint": "prettier --check \"src/**/*.ts\"",
        "lint:fix": "prettier --write \"src/**/*.ts\"",
        "test": "vitest run --passWithNoTests --config ../../vitest.config.ts",
        "typecheck": "tsc --noEmit",
        "build": "tsup",
        "watch": "tsup --watch",
        "probe": "node scripts/probe.mjs"
    },
    "dependencies": {
        "@sirubot/utils": "*",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/node": "^22.20.5"
    }
}
