// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
generator client {
  provider   = "prisma-client-js"
  output     = "../dist"
}

datasource db {
  provider = "postgresql"
}

model Guild {
  id            String   @id
  volume        Int      @default(10)
  textChannelId String?
  voiceChannelId String?
  enableController Boolean @default(true)
  sponsorBlockSegments String[] @default([])
  
  djRoleId      String?
  repeat        String   @default("off")
  related       Boolean  @default(false)
  // 고정 채널: 이 채널의 입력 텍스트를 검색어로 재생. mode: "play"(즉시 재생) | "select"(5개 선택)
  pinnedChannelId   String?
  pinnedChannelMode String  @default("play")
  // 고정 채널 입력 메시지를 봇이 처리한 뒤 삭제할지 (Manage Messages 권한 필요)
  pinnedChannelDeleteInput Boolean @default(false)
  // 임시 음성채널(JTC): 마커 채널 입장 시 방 생성. template의 {user}는 방장 이름으로 치환
  jtcEnabled         Boolean @default(false)
  jtcCategoryId      String?
  jtcMarkerChannelId String?
  jtcTemplate        String  @default("{user}의 방")
  jtcUserLimit       Int     @default(0)
  gaplessEnabled Boolean @default(true)
  crossfadeEnabled Boolean @default(true)
  crossfadeMs   Int      @default(5000)
  // AI 채팅 설정: all(모든 채널) | channels(특정 채널만) | off(끄기). 시스템 프롬프트는 서버별 커스터마이징을 지원하지 않아요 (프롬프트 인젝션 위험).
  aiMode               String   @default("all")
  aiChannelIds         String[] @default([])
  // 채팅 TTS: off(기본) | channels(특정 채널만) | all. 채팅 메시지를 음성으로 읽어요 (docs/plans/2026-10-18-chat-tts-spec.md).
  ttsMode              String   @default("off")
  ttsChannelIds        String[] @default([])
  // 커스텀 명령어 접두사 — 메시지가 이 문자열로 시작하면 길드 커스텀 명령어로 처리해요. 규칙은 packages/utils/src/customCommand.ts.
  customCommandPrefix String @default("!")
  // 채팅 유틸: 이모지 확대 — 커스텀 이모지만으로 구성된 메시지를 큰 이미지로 다시 보여줘요 (all | channels | off)
  emojiEnlargeMode       String   @default("off")
  emojiEnlargeChannelIds String[] @default([])
  // 채팅 유틸: 메시지 인용 — discord.com/channels/... 링크를 자체 인용 임베드로 보여줘요 (all | channels | off)
  quoteMode       String   @default("off")
  quoteChannelIds String[] @default([])
  // 채팅 유틸: 임베드 복구 — X·인스타그램은 fix 도메인으로 재전송, BOOTH는 자체 OG 임베드. 계약은 packages/utils/src/chatTools.ts (all | channels | off)
  embedFixMode       String   @default("off")
  embedFixChannelIds String[] @default([])
  embedFixSites          String[] @default([])
  embedFixSuppressOriginal Boolean @default(false)
  // 채팅 유틸: 카운팅 채널 — 지정 채널에서 숫자를 순서대로 세고 틀리면 초기화해요
  countingEnabled  Boolean @default(false)
  countingChannelId String?
  // 멤버 인사: 입장/퇴장 메시지 + 커스텀 카드 이미지 설정. 구조는 packages/utils/src/memberGreeting.ts 타입과 동기화.
  welcome       Json?
  goodbye       Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  history       GuildTrackHistory[]
  customCommands CustomCommand[]
  assets        GuildAsset[]
}

// 커스텀 명령어 — 대시보드(관리자)가 만드는 접두사 메시지 명령어. 봇의 접두사 리스너가 spec(JSON 스텝 체인)을 순차 실행해요.
// name은 접두사 뒤 첫 토큰으로 매칭돼요 (공백 불가, 소문자 정규화, 예약어 '도움말' 금지). spec 검증은 packages/utils/src/customCommand.ts의 zod 스키마.
model CustomCommand {
  id          String   @id @default(uuid())
  guildId     String
  name        String
  description String   @default("")
  /// 실행 방식 — 'prefix' | 'slash'. 생성 시점에 정해지고 바뀌지 않아요 (packages/utils/src/customCommand.ts의 method 계약).
  method      String   @default("prefix")
  /// 슬래시형 등록 후 Discord application command ID — 증분 동기화(생성/수정/삭제)에 써요.
  applicationCommandId String?
  spec        Json
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, name])
  @@index([guildId])
}

/// 길드 이미지 에셋 — S3 스타일 스토리지(apps/storage)에 올린 파일의 메타데이터.
/// 커스텀 명령어의 섹션 썸네일·미디어 갤러리가 url로 참조해요 (스펙은 https URL 계약 유지).
model GuildAsset {
  id         String   @id @default(uuid())
  guildId    String
  bucket     String
  key        String
  name       String
  mimeType   String
  sizeBytes  Int
  /// 공개 GET URL — 스토리지가 돌려준 URL을 그대로 저장해요
  url        String
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  guild      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([bucket, key])
  @@index([guildId, createdAt(sort: Desc)])
}

model Track {
  id          String   @id // YouTube ID, Spotify ID, etc.
  title       String
  artist      String
  duration    Int      // Duration in milliseconds
  thumbnail   String?
  url         String
  source      String   // 'youtube', 'spotify', 'soundcloud', etc.
  
  // Statistics
  totalPlays  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  history       GuildTrackHistory[]
  playlistTracks PlaylistTrack[]
}

model User {
  id          String          @id // Discord user ID
  // 프로필: 생일(월/일) — 별자리 자동 변환용. 연도는 저장하지 않아요.
  birthMonth  Int?
  birthDay    Int?
  // 프로필 카드의 한 줄 소개 (120자 이내). 비우면 소개 칸을 생략해요.
  intro       String?         @db.VarChar(120)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relations
  history     GuildTrackHistory[]
  playlists   Playlist[]
  gameRecords GameRecord[]
  userToken   UserToken?
}

// 대시보드 Discord OAuth 토큰 — refresh/access 토큰의 서버측 단일 원본 (저장 전 AES-256-GCM 암호화).
model UserToken {
  userId               String   @id // = User.id (Discord 사용자 ID)
  refreshToken         String   // 암호화된 refresh token
  accessToken          String   // 암호화된 access token
  accessTokenExpiresAt DateTime // access token 만료 시각
  version              Int      @default(1)
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 게임 전적/기록 — 모든 미니게임의 영속 저장소 (인메모리 Map 대체).
// game: 'rps' | 'guess' | 'dice' | 'attendance' | 'quiz'
// result: 'win' | 'loss' | 'draw' | 'checkin'
// meta 예시: rps {} / guess { attempts: 3 } / attendance { streak: 7, day: '2026-10-05' }
model GameRecord {
  id        String   @id @default(uuid())
  userId    String
  game      String
  result    String
  meta      Json?
  playedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, game, playedAt(sort: Desc)])
}

model GuildTrackHistory {
  id        String   @id @default(uuid())
  guildId   String
  trackId   String
  userId    String?  // Who requested the track
  createdAt DateTime @default(now())

  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([guildId, createdAt(sort: Desc)])
}

model Playlist {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks      PlaylistTrack[]

  @@index([userId])
}

model PlaylistTrack {
  id         String   @id @default(uuid())
  playlistId String
  trackId    String
  position   Int      
  addedAt    DateTime @default(now())

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, position])
  @@index([playlistId])
}

// AI 채팅 대화 기록 (채널별 영속화) — guildId는 대시보드 서버 단위 삭제용
model ChannelChatHistory {
  channelId String   @id
  guildId   String?
  messages  Json
  updatedAt DateTime @updatedAt

  @@index([guildId])
}

// 채팅 TTS 사용자 설정 — 길드별 사용자 opt-in(off 기본)과 음성 프리셋(voice/speed/pitch)
model TtsUserSetting {
  guildId String
  userId  String
  // opt-in: 채팅 낭독 대상에 포함될지 (길드 단위)
  enabled Boolean @default(false)
  // 음성 프리셋: engine:voice 식별자. null이면 봇 기본 음성 사용
  voice   String?
  // 속도 0.25~4, 피치 -12~12. null이면 엔진 기본값
  speed   Float?
  pitch   Float?

  updatedAt DateTime @updatedAt

  @@id([guildId, userId])
}

// 사용자 메모리 — 에이전트가 memory 도구로 자동 갱신하는 장기/단기 기억
model UserMemory {
  userId String @id
  // 장기 기억: Muse식 MEMORY.md 마크다운 (# MEMORY.md + Facts/Preferences/Commitments 섹션)
  longTerm  Json?
  // 단기 기억: [{ q, a, at, channelId }] — 최근 대화 하이라이트 (최대 8개)
  shortTerm Json?
  // nightly pass(기억 정리 배치) 마지막 수행 시각
  tidiedAt  DateTime?
  updatedAt DateTime @updatedAt
}

// 소셜 알림 구독 — apps/notifier가 소유하는 도메인이에요 (봇은 웹훅 생성 시점에만 관여).
// 감지된 이벤트(YT WebSub·TW EventSub 콜백, 치지직 live-status 폴링)는 저장된 웹훅으로
// 봇을 거치지 않고 직접 POST 돼요. 계약은 packages/utils/src/social.ts.
model SocialSubscription {
  id               String    @id @default(uuid())
  guildId          String
  /// 플랫폼 — 'youtube' | 'chzzk' | 'twitch' (social.ts socialPlatformSchema)
  platform         String
  /// 플랫폼별 채널 식별자 — YT 채널ID(UC...) / 치지직 채널ID(32-hex) / Twitch 사용자ID
  sourcePlatformId String
  /// 표시용 채널 이름 — 임베드 author와 대시보드 라벨로 써요
  sourceName       String
  /// 알림을 받을 디스코드 채널 ID
  targetChannelId  String
  /// 봇이 생성한 웹훅 식별자 — 전송은 webhookId+token 조합 URL로 POST해요
  webhookId        String
  /// 웹훅 token — 민감정보: 대시보드 응답에서는 마스킹해요
  webhookToken     String
  /// content 커스텀 템플릿 — null이면 임베드만 전송. 변수 {title} {url} {author}, 멘션 <#채널ID> <@&역할ID> (social.ts 계약)
  messageTemplate  String?
  /// 배달 상태 — 'active' | 'failed' | 'disabled'. 연속 5회 실패 또는 웹훅 404/410이면 failed
  status           String    @default("active")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([guildId, platform, sourcePlatformId, targetChannelId])
  @@index([platform, sourcePlatformId])
}

// 소셜 이벤트 배달 이력 — (platform, contentId)로 중복 알림을 막는 진실 원천이에요.
// WebSub/EventSub 중복 콜백, 폴링·RSS 감사 경합, 재시작 후 재전송을 전부 여기서 방어해요.
model SocialEventLog {
  id          String   @id @default(uuid())
  /// 이벤트 플랫폼 — 'youtube' | 'chzzk' | 'twitch'
  platform    String
  /// 플랫폼별 콘텐츠 식별자 — YT 영상ID / 치지직 liveID / Twitch 방송ID
  contentId   String
  /// 정규화 이벤트 스냅샷 — social.ts socialEventSchema
  payload     Json
  deliveredAt DateTime @default(now())

  @@unique([platform, contentId])
  @@index([deliveredAt])
}

