// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
generator client {
  provider   = "prisma-client-js"
  output     = "../dist"
}

datasource db {
  provider = "postgresql"
}

model Guild {
  id            String   @id
  volume        Int      @default(10)
  textChannelId String?
  voiceChannelId String?
  enableController Boolean @default(true)
  sponsorBlockSegments String[] @default([])
  
  djRoleId      String?
  repeat        String   @default("off")
  related       Boolean  @default(false)
  // 고정 채널: 이 채널의 입력 텍스트를 검색어로 재생. mode: "play"(즉시 재생) | "select"(5개 선택)
  pinnedChannelId   String?
  pinnedChannelMode String  @default("play")
  // 임시 음성채널(JTC): 마커 채널 입장 시 방 생성. template의 {user}는 방장 이름으로 치환
  jtcEnabled         Boolean @default(false)
  jtcCategoryId      String?
  jtcMarkerChannelId String?
  jtcTemplate        String  @default("{user}의 방")
  jtcUserLimit       Int     @default(0)
  gaplessEnabled Boolean @default(true)
  crossfadeEnabled Boolean @default(true)
  crossfadeMs   Int      @default(5000)
  // AI 채팅 설정: 서버 on/off, 모델/시스템 프롬프트 오버라이드(없으면 env 기본), 채널별 비활성화 목록
  aiEnabled            Boolean  @default(true)
  aiModel              String?
  aiSystemPrompt       String?
  aiDisabledChannelIds String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  history       GuildTrackHistory[]
}

model Track {
  id          String   @id // YouTube ID, Spotify ID, etc.
  title       String
  artist      String
  duration    Int      // Duration in milliseconds
  thumbnail   String?
  url         String
  source      String   // 'youtube', 'spotify', 'soundcloud', etc.
  
  // Statistics
  totalPlays  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  history       GuildTrackHistory[]
  playlistTracks PlaylistTrack[]
}

model User {
  id          String          @id // Discord user ID
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relations
  history     GuildTrackHistory[]
  playlists   Playlist[]
}

model GuildTrackHistory {
  id        String   @id @default(uuid())
  guildId   String
  trackId   String
  userId    String?  // Who requested the track
  createdAt DateTime @default(now())

  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([guildId, createdAt(sort: Desc)])
}

model Playlist {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks      PlaylistTrack[]

  @@index([userId])
}

model PlaylistTrack {
  id         String   @id @default(uuid())
  playlistId String
  trackId    String
  position   Int      
  addedAt    DateTime @default(now())

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, position])
  @@index([playlistId])
}

// AI 채팅 대화 기록 (채널별 영속화) — guildId는 대시보드 서버 단위 삭제용
model ChannelChatHistory {
  channelId String   @id
  guildId   String?
  messages  Json
  updatedAt DateTime @updatedAt

  @@index([guildId])
}

// 사용자 메모리 — 에이전트가 memory 도구로 자동 갱신하는 장기/단기 기억
model UserMemory {
  userId String @id
  // 장기 기억: Muse식 MEMORY.md 마크다운 (# MEMORY.md + Facts/Preferences/Commitments 섹션)
  longTerm  Json?
  // 단기 기억: [{ q, a, at, channelId }] — 최근 대화 하이라이트 (최대 8개)
  shortTerm Json?
  // nightly pass(기억 정리 배치) 마지막 수행 시각
  tidiedAt  DateTime?
  updatedAt DateTime @updatedAt
}

