generator client {
  provider   = "prisma-client-js"
  output     = "../dist"
}

datasource db {
  provider = "postgresql"
}

model Guild {
  id            String   @id
  volume        Int      @default(10)
  ttsVolume     Int      @default(100)
  ttsDuckLevel  Float    @default(0.2)
  textChannelId String?
  voiceChannelId String?
  enableController Boolean @default(true)
  sponsorBlockSegments String[] @default([])
  
  djRoleId      String?
  repeat        String   @default("off")
  related       Boolean  @default(false)
  textMessageId   String?
  textChannelInputPlay Boolean @default(false)
  // "play" | "select"
  textChannelMode String  @default("play")
  textChannelDeleteInput Boolean @default(false)
  jtcEnabled         Boolean @default(false)
  jtcCategoryId      String?
  jtcMarkerChannelId String?
  jtcTemplate        String  @default("{user}의 방")
  jtcUserLimit       Int     @default(0)
  // "pink" | "blue" | "purple" | "green" | "orange" | "yellow"
  themePreset   String   @default("pink")
  gaplessEnabled Boolean @default(true)
  crossfadeEnabled Boolean @default(true)
  crossfadeMs   Int      @default(5000)
  normalizationEnabled Boolean @default(false)
  automixEnabled Boolean @default(false)
  automixMaxTempoChange Float @default(0.06)
  automixMinConfidence Float @default(0.30)
  // "sequential" | "parallel" | "interrupt"
  ttsAnnounceMode      String   @default("sequential")
  // "all" | "channels" | "off"
  aiMode               String   @default("all")
  aiChannelIds         String[] @default([])
  // "off" | "channels" | "all"
  ttsMode              String   @default("off")
  ttsChannelIds        String[] @default([])
  ttsJoinAnnounce      Boolean  @default(false)
  ttsLeaveAnnounce     Boolean  @default(false)
  customCommandPrefix String @default("!")
  // "all" | "channels" | "off"
  emojiEnlargeMode       String   @default("off")
  emojiEnlargeChannelIds String[] @default([])
  // "all" | "channels" | "off"
  quoteMode       String   @default("off")
  quoteChannelIds String[] @default([])
  // "all" | "channels" | "off"
  embedFixMode       String   @default("off")
  embedFixChannelIds String[] @default([])
  embedFixSites          String[] @default([])
  embedFixSuppressOriginal Boolean @default(false)
  embedFixTranslateLang    String   @default("off")
  countingEnabled  Boolean @default(false)
  countingChannelId String?
  disabledModules  String[] @default([])
  welcome       Json?
  goodbye       Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  history       GuildTrackHistory[]
  customCommands CustomCommand[]
  assets        GuildAsset[]
  ticketConfig  TicketConfig?
  tickets       Ticket[]
  rolePanels    RolePanel[]
  starboardSettings StarboardSettings?
  starboardEntries  StarboardEntry[]
  scheduledMessageSettings ScheduledMessageSettings?
  birthdaySettings BirthdaySettings?
  birthdayOptIns   BirthdayOptIn[]
  birthdayRoleGrants BirthdayRoleGrant[]
  giveaways     Giveaway[]
}

model CustomCommand {
  id          String   @id @default(uuid())
  guildId     String
  name        String
  description String   @default("")
  // "prefix" | "slash"
  method      String   @default("prefix")
  applicationCommandId String?
  spec        Json
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, name])
  @@index([guildId])
}

model GuildAsset {
  id         String   @id @default(uuid())
  guildId    String
  bucket     String
  key        String
  name       String
  mimeType   String
  sizeBytes  Int
  url        String
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  guild      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([bucket, key])
  @@index([guildId, createdAt(sort: Desc)])
}

model Track {
  id          String   @id
  title       String
  artist      String
  duration    Int
  thumbnail   String?
  url         String
  source      String
  
  totalPlays  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  isrc          String?
  // "lavalink" | "recording" | "deezer" | "musicbrainz"
  isrcSource    String?
  isrcCheckedAt DateTime?
  recordingId   String?

  recording      Recording?          @relation(fields: [recordingId], references: [id], onDelete: SetNull)
  history        GuildTrackHistory[]
  playlistTracks PlaylistTrack[]

  @@index([recordingId])
  @@index([isrcCheckedAt])
}

model Recording {
  id         String   @id @default(uuid())
  // "rec:<artist>|<title>" (non-unique; ±3s matched in code)
  key        String
  isrc       String?  @unique
  title      String
  artist     String
  duration   Int
  thumbnail  String?
  source     String
  totalPlays Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tracks Track[]
  daily  RecordingDailyPlay[]

  @@index([key])
  @@index([totalPlays(sort: Desc)])
}

model RecordingDailyPlay {
  recordingId String
  day         DateTime @db.Date
  guildId     String
  plays       Int      @default(0)

  recording Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@id([recordingId, day, guildId])
  @@index([day])
}

model GuildLifecycle {
  guildId     String    @id
  joinedAt    DateTime
  leftAt      DateTime?
  onboardedAt DateTime?
  firstUseAt  DateTime?
  joinCount   Int       @default(0)

  @@index([joinedAt])
}

model FeatureDailyUse {
  day     DateTime @db.Date
  feature String
  count   Int      @default(0)

  @@id([day, feature])
  @@index([day])
}

enum ScheduledJobStatus {
  pending
  running
  done
  failed
}

model ScheduledJob {
  id        String             @id @default(uuid())
  guildId   String
  kind      String
  runAt     DateTime
  payload   Json               @default("{}")
  status    ScheduledJobStatus @default(pending)
  attempts  Int                @default(0)
  lockedBy  String?
  lockedAt  DateTime?
  lastError String?
  createdBy String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([status, runAt])
  @@index([guildId])
}

model User {
  id          String          @id
  birthMonth  Int?
  birthDay    Int?
  intro       String?         @db.VarChar(120)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  history     GuildTrackHistory[]
  playlists   Playlist[]
  gameRecords GameRecord[]
  userToken   UserToken?
  birthdayOptIns BirthdayOptIn[]
}

model UserToken {
  userId               String   @id
  refreshToken         String
  accessToken          String
  accessTokenExpiresAt DateTime
  version              Int      @default(1)
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GameRecord {
  id        String   @id @default(uuid())
  userId    String
  // "rps" | "guess" | "dice" | "attendance" | "quiz"
  game      String
  // "win" | "loss" | "draw" | "checkin"
  result    String
  meta      Json?
  playedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, game, playedAt(sort: Desc)])
}

model GuildTrackHistory {
  id        String   @id @default(uuid())
  guildId   String
  trackId   String
  userId    String?
  createdAt DateTime @default(now())

  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([guildId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([trackId])
  @@index([createdAt])
}

model Playlist {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks      PlaylistTrack[]

  @@index([userId])
}

model PlaylistTrack {
  id         String   @id @default(uuid())
  playlistId String
  trackId    String
  position   Int      
  addedAt    DateTime @default(now())

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, position])
  @@index([trackId])
}

model ChannelChatHistory {
  channelId String   @id
  guildId   String?
  messages  Json
  updatedAt DateTime @updatedAt

  @@index([guildId])
}

model TtsPronunciation {
  guildId String
  term    String
  reading String

  updatedAt DateTime @updatedAt

  @@id([guildId, term])
}

model TtsUserSetting {
  guildId String
  userId  String
  enabled Boolean @default(false)
  voice   String?
  // "both" | "left" | "right"
  channel String  @default("both")
  // "neutral" | "happy" | "sad" | "angry" | "whisper"
  emotion String  @default("neutral")

  updatedAt DateTime @updatedAt

  @@id([guildId, userId])
}

model UserMemory {
  userId String @id
  longTerm  Json?
  shortTerm Json?
  shortTermSummary String?
  tidiedAt  DateTime?
  updatedAt DateTime @updatedAt
}

model SocialSubscription {
  id               String    @id @default(uuid())
  guildId          String
  // "youtube" | "chzzk" | "twitch"
  platform         String
  sourcePlatformId String
  sourceName       String
  targetChannelId  String
  webhookId        String
  webhookToken     String
  messageTemplate  String?
  webhookName      String?
  webhookAvatarUrl String?
  showThumbnail    Boolean   @default(true)
  // "active" | "failed" | "disabled"
  status           String    @default("active")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([guildId, platform, sourcePlatformId, targetChannelId])
  @@index([platform, sourcePlatformId])
  @@index([platform, status])
  @@index([status])
}

model SocialEventLog {
  id          String   @id @default(uuid())
  // "youtube" | "chzzk" | "twitch"
  platform    String
  contentId   String
  payload     Json
  deliveredAt DateTime @default(now())

  @@unique([platform, contentId])
  @@index([deliveredAt])
}

model TicketConfig {
  guildId          String   @id
  guild            Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  enabled          Boolean  @default(false)
  categoryId       String?
  supportRoleIds   String[] @default([])
  logChannelId     String?
  maxOpenPerUser   Int      @default(1)
  panelChannelId   String?
  panelMessageId   String?
  panelTitle       String   @default("고객지원 티켓")
  panelDescription String   @default("아래 버튼을 눌러 담당자와 1:1 비공개 상담 채널을 개설해요.")
  ticketCounter    Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Ticket {
  id           String    @id @default(uuid())
  guildId      String
  guild        Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId    String    @unique
  ticketNumber Int
  ownerId      String
  // "open" | "closed"
  status       String    @default("open")
  claimedById  String?
  closedById   String?
  closeReason  String?
  transcriptKey String?
  transcribedAt DateTime?
  createdAt    DateTime  @default(now())
  closedAt     DateTime?

  @@unique([guildId, ticketNumber])
  @@index([guildId, ownerId, status])
  @@index([guildId, status])
}

model RolePanel {
  id          String   @id @default(uuid())
  guildId     String
  name        String
  title       String
  description String   @default("")
  imageUrl    String?
  // "gallery" | "thumbnail"
  imageLayout   String @default("gallery")
  // "top" | "middle" | "bottom"
  imagePosition String @default("middle")
  accentColor   String?
  // "button" | "reaction"
  mode        String   @default("button")
  clickCount  Int      @default(0)
  channelId   String?
  messageId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild       Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  buttons     RolePanelButton[]

  @@index([guildId])
}

model RolePanelButton {
  id       String   @id @default(uuid())
  panelId  String
  roleId   String
  label    String
  emoji    String?
  // "secondary" | "primary" | "success" | "danger"
  style    String   @default("secondary")
  position Int      @default(0)

  panel    RolePanel @relation(fields: [panelId], references: [id], onDelete: Cascade)

  @@index([panelId])
}

model ScheduledMessageSettings {
  guildId            String   @id
  guild              Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  maxActive          Int      @default(25)
  minIntervalMinutes Int      @default(10)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model StarboardSettings {
  guildId           String   @id
  guild             Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId         String?
  emoji             String   @default("⭐")
  threshold         Int      @default(3)
  excludeSelf       Boolean  @default(true)
  excludeNsfw       Boolean  @default(true)
  ignoredChannelIds String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model StarboardEntry {
  sourceMessageId    String   @id
  guildId            String
  guild              Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  sourceChannelId    String
  starboardChannelId String
  starboardMessageId String
  count              Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([guildId])
}

model BirthdaySettings {
  guildId          String   @id
  guild            Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  config           Json
  sendTime         String   @default("09:00")
  roleId           String?
  activeFrom       String?
  lastCelebratedOn String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model BirthdayOptIn {
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([guildId, userId])
  @@index([userId])
}

model BirthdayRoleGrant {
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId    String
  roleId    String
  grantedOn String
  createdAt DateTime @default(now())

  @@id([guildId, userId])
}

enum GiveawayStatus {
  running
  ended
  cancelled
}

model Giveaway {
  id            String          @id @default(uuid())
  guildId       String
  guild         Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId     String
  messageId     String?
  prize         String
  winnerCount   Int
  endsAt        DateTime
  requirements  Json            @default("{\"version\":1,\"conditions\":[]}")
  status        GiveawayStatus  @default(running)
  winnerIds     String[]        @default([])
  entryCount    Int?
  eligibleCount Int?
  endedAt       DateTime?
  announcedAt   DateTime?
  createdBy     String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  entries       GiveawayEntry[]

  @@index([guildId, status])
}

model GiveawayEntry {
  giveawayId String
  giveaway   Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  userId     String
  enteredAt  DateTime @default(now())

  @@id([giveawayId, userId])
}

model LyricsTranslation {
  sourceHash String   @id
  lines      Json
  model      String
  createdAt  DateTime @default(now())
}
