{
    "name": "@sirubot/prisma",
    "private": true,
    "version": "0.1.0",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "generate": "prisma generate --schema=src/schema.prisma",
        "lint": "prettier --check \"prisma.config.ts\"",
        "lint:fix": "prettier --write \"prisma.config.ts\"",
        "migrate:dev": "prisma migrate dev --schema=src/schema.prisma",
        "migrate:deploy": "prisma migrate deploy",
        "test": "vitest run --passWithNoTests --config ../../vitest.config.ts",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@prisma/client": "^7.10.1",
        "prisma": "^7.10.1"
    }
}
